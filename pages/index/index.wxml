<!-- 轮播图 -->
<view class="jd-banner-container">
  <swiper class="jd-banner-swiper" indicator-dots="true" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#E4393C" autoplay circular>
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="jd-banner-item">
        <image mode="aspectFill" bindtap="tapBanner" data-item="{{ item }}" src="{{item.picUrl}}" />
      </view>
    </swiper-item>
  </swiper>
</view>

<!-- 商品列表 -->
<view class="jd-main-container">
  <view class="jd-section-header">
    <view class="jd-section-title">
      <image class="jd-section-icon" src="../../images/home/goodslist.png"></image>
      <text class="jd-section-name">为你推荐</text>
    </view>
  </view>
  <view class="jd-goods-grid">
    <view class="jd-goods-card" wx:for="{{goods}}" wx:key="id" bindtap="toDetailsTap" data-id="{{item.id}}">
      <view class="jd-goods-img-wrap">
        <image src="{{item.pic}}" mode="aspectFill" lazy-load="true" />
      </view>
      <view class="jd-goods-info">
        <view class="jd-goods-name">{{item.name}}</view>
        <view wx:if="{{item.characteristic}}" class="jd-goods-desc">{{item.characteristic}}</view>
        <view class="jd-goods-price-box">
          <!-- 情况4：售价=0 且 积分=0 → 免费 -->
          <block wx:if="{{(!item.minPrice || item.minPrice <= 0) && (!item.minScore || item.minScore <= 0)}}">
            <view class="jd-price-free-badge">免费</view>
            <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="jd-goods-original-price">¥{{item.originalPrice}}</text>
          </block>
          <!-- 情况2：售价=0，积分≠0 -->
          <block wx:elif="{{(!item.minPrice || item.minPrice <= 0) && item.minScore > 0}}">
            <view class="jd-price-score-wrap">
              <text class="jd-price-score-num jd-price-score-sm">{{item.minScore}}</text>
              <text class="jd-price-score-unit jd-price-score-unit-sm">积分</text>
            </view>
            <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="jd-goods-original-price">¥{{item.originalPrice}}</text>
          </block>
          <!-- 情况3：售价≠0 且 积分≠0 -->
          <block wx:elif="{{item.minPrice > 0 && item.minScore > 0}}">
            <view class="jd-price-combo-wrap jd-price-combo-sm">
              <view class="jd-price-money-wrap">
                <text class="jd-price-symbol jd-goods-price-sym">¥</text>
                <text class="jd-price-num jd-goods-price-num">{{item.minPrice}}</text>
              </view>
              <text class="jd-price-plus">+</text>
              <view class="jd-price-score-wrap">
                <text class="jd-price-score-num jd-price-score-sm">{{item.minScore}}</text>
                <text class="jd-price-score-unit jd-price-score-unit-sm">积分</text>
              </view>
            </view>
            <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="jd-goods-original-price">¥{{item.originalPrice}}</text>
          </block>
          <!-- 情况1：售价≠0，积分=0（默认） -->
          <block wx:else>
            <view class="jd-goods-price">
              <text class="jd-price-symbol jd-goods-price-sym">¥</text>
              <text class="jd-price-num jd-goods-price-num">{{item.minPrice}}</text>
            </view>
            <text wx:if="{{item.originalPrice && item.originalPrice > 0}}" class="jd-goods-original-price">¥{{item.originalPrice}}</text>
          </block>
        </view>
      </view>
    </view>
  </view>
  <van-divider wx:if="{{ !loadingMoreHidden }}" custom-class="jd-end-divider" contentPosition="center">— 已经到底啦 —</van-divider>
</view>

<!-- 返回顶部按钮 -->
<view wx:if="{{showBackTop}}" class="jd-float-btns">
  <view class="jd-float-btn" bindtap="scrollToTop">
    <van-icon name="arrow-up" size="18px" color="rgba(255,255,255,0.9)" />
    <text class="jd-float-btn-text">顶部</text>
  </view>
</view>
