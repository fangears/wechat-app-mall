/* 系统设置页：与“我的”页统一的简约卡片样式 */
page {
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.setting-container {
  min-height: 100vh;
  padding: 24rpx 0 40rpx;
}

.menu-card {
  margin: 0 32rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-item {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #fafafa;
}

.menu-label {
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

.version-text {
  font-size: 26rpx;
  color: #999;
}
