<view class="setting-container">
  <!-- 通用 -->
  <view class="menu-card">
    <navigator url="/pages/about/index" class="menu-item">
      <view class="menu-label">关于我们</view>
      <text class="arrow">›</text>
    </navigator>
    <view class="menu-item" bindtap="openSetting">
      <view class="menu-label">权限与设置</view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="clearStorage">
      <view class="menu-label">清除缓存</view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="setEnableDebug">
      <view class="menu-label">{{ enableDebug ? '关闭调试模式' : '打开调试模式' }}</view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 账号 -->
  <view class="menu-card">
    <navigator url="/pages/my/devices" class="menu-item">
      <view class="menu-label">登录设备</view>
      <text class="arrow">›</text>
    </navigator>
    <navigator url="/pages/my/deactivate/step1" class="menu-item">
      <view class="menu-label">注销账号</view>
      <text class="arrow">›</text>
    </navigator>
  </view>

  <!-- 版本 -->
  <view class="menu-card">
    <view class="menu-item">
      <view class="menu-label">当前版本</view>
      <text class="version-text">{{version}}</text>
    </view>
  </view>
</view>
